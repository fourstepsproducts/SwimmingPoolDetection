# Server Ports
PORT=5000

# Client origin CORS rule
CORS_ORIGIN=http://localhost:5173

# Database configuration (Optional - fallback to memory mock if offline)
MONGODB_URI=mongodb://localhost:27017/poolsafety

# Large File Upload Configuration (in Gigabytes)
MAX_UPLOAD_SIZE_GB=5

# Configurable video frame processing interval (e.g. process 1 frame out of every N frames)
PROCESS_EVERY_N_FRAMES=30

# Pool calibration corner points (relative to 1920x1080 reference frame)
POOL_POINT_A_X=530
POOL_POINT_A_Y=160
POOL_POINT_B_X=1380
POOL_POINT_B_Y=160
POOL_POINT_C_X=1520
POOL_POINT_C_Y=480
POOL_POINT_D_X=350
POOL_POINT_D_Y=480


