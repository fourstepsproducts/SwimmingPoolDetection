# API Server URLs
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Maximum CCTV video upload size limit (in Gigabytes)
VITE_MAX_UPLOAD_SIZE_GB=5

# Pool calibration corner points (relative to 1920x1080 reference frame)
VITE_POOL_POINT_A_X=530
VITE_POOL_POINT_A_Y=160
VITE_POOL_POINT_B_X=1380
VITE_POOL_POINT_B_Y=160
VITE_POOL_POINT_C_X=1520
VITE_POOL_POINT_C_Y=480
VITE_POOL_POINT_D_X=350
VITE_POOL_POINT_D_Y=480


